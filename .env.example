# Yahoo Developer app credentials — apply at https://sports.yahoo.com/developer/access/
# (manual review since 2026; see docs/yahoo-api.md). Read scope is fspt-r.
# Copy this file to .env and fill in once approved.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Filled in after the first OAuth handshake (scripts/yahoo_auth.py)
YAHOO_REFRESH_TOKEN=

# Your league, once known. Format is {game_key}.l.{league_id}, e.g. 461.l.12345
# (the game_key changes every season; the script can look it up)
YAHOO_LEAGUE_KEY=
